    warn("[DIAG] ❌ Networking folder missing — cannot scan eggs.")
    return
end

local snapRF = Networking:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot")
print("[DIAG] Snapshot RF      :", snapRF and "found" or "MISSING")

if not snapRF then
    warn("[DIAG] ❌ RF/EggWorld/AskFieldEggSnapshot missing!")
    print("[DIAG] Networking children:")
    for _, c in ipairs(Networking:GetChildren()) do
        print("         •", c.Name, "(" .. c.ClassName .. ")")
    end
    return
end

-- ── 3. Snapshot call ───────────────────────────────────
print("[DIAG] Calling snapshot RF...")
local ok, res = pcall(function() return snapRF:InvokeServer() end)
if not ok then
    warn("[DIAG] ❌ Snapshot call errored:", tostring(res))
    return
end
print("[DIAG] Snapshot returned:", type(res))
if type(res) == "table" then
    local count = 0
    if type(res.Records) == "table" then
        for _ in pairs(res.Records) do count = count + 1 end
    end
    print("[DIAG] Records count    :", count)
    print("[DIAG] Result keys      :")
    for k in pairs(res) do print("         •", k) end
    -- print first record so we know the shape
    for _, rec in pairs(res.Records or {}) do
        print("[DIAG] Sample record   :")
        for k, v in pairs(rec) do
            if type(v) ~= "table" then print("         •", k, "=", tostring(v)) end
        end
        break
    end
else
    warn("[DIAG] ❌ Snapshot did not return a table")
    return
end

