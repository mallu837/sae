-- ── 5. HTTP to Firebase ────────────────────────────────
local function httpTest(url)
    print("[DIAG] GET", url)
    if type(request) == "function" then
        local ok, r = pcall(request, {Url = url, Method = "GET"})
        if ok and type(r) == "table" then
            print("[DIAG]   → status:", r.StatusCode or r.Status, " body:", tostring(r.Body):sub(1, 120))
            return r.StatusCode or r.Status, r.Body
        else
            print("[DIAG]   → request() failed:", tostring(r))
        end
    end
    if type(syn) == "table" and type(syn.request) == "function" then
        local ok, r = pcall(syn.request, {Url = url, Method = "GET"})
        if ok and type(r) == "table" then
            print("[DIAG]   → status:", r.StatusCode or r.Status, " body:", tostring(r.Body):sub(1, 120))
            return r.StatusCode or r.Status, r.Body
        end
    end
    local ok, r = pcall(function()
        return HttpService:RequestAsync({Url = url, Method = "GET"})
    end)
    if ok and type(r) == "table" then
        print("[DIAG]   → RequestAsync status:", r.StatusCode, " body:", tostring(r.Body):sub(1, 120))
        return r.StatusCode, r.Body
    end
    if game.HttpGet then
        local ok2, b = pcall(game.HttpGet, game, url)
        if ok2 then print("[DIAG]   → HttpGet body:", tostring(b):sub(1, 120)); return 200, b end
    end
    warn("[DIAG]   → no HTTP method succeeded")
    return 0, nil
end

local DB = "https://newlogs-7c69a-default-rtdb.firebaseio.com"
local code1, body1 = httpTest(DB .. "/config/minValue.json")
if code1 == 401 or code1 == 403 then
    warn("[DIAG] ❌ Firebase denies access (" .. code1 .. ") — the DB is locked down.")
end
if code1 == 0 then
    warn("[DIAG] ❌ No HTTP wrapper works in this executor — script cannot talk to Firebase.")
end
if code1 == 200 then
    print("[DIAG] ✅ Firebase reachable. minValue =", body1)
end

-- ── 6. WebSocket ───────────────────────────────────────
if type(WebSocket) == "table" and type(WebSocket.connect) == "function" then
    print("[DIAG] Testing WebSocket...")
    local ok, ws = pcall(WebSocket.connect, "wss://newlogs-7c69a-default-rtdb.firebaseio.com/.ws?v=5&ns=newlogs-7c69a-default-rtdb")
    if ok and ws then
        print("[DIAG] ✅ WebSocket connected")
        local got = false
        pcall(function()
            ws.OnMessage:Connect(function(m) print("[DIAG]   WS msg:", tostring(m):sub(1, 80)); got = true end)
        end)
        task.wait(3)
        if not got then print("[DIAG]   (no message in 3s — may still be fine)") end
        pcall(function() ws:Close() end)
    else
        warn("[DIAG] ❌ WebSocket connect failed:", tostring(ws))
    end
else
    warn("[DIAG] ⚠️  WebSocket not available — script will use REST-only polling")
end

